# HERE Geocoding & Search API key — https://platform.here.com/
# Required. The app cannot resolve addresses without it.
HERE_API_KEY=your-here-api-key

# OpenAI API key — https://platform.openai.com/api-keys
# Optional here: if unset, the app prompts for it in the sidebar instead.
OPENAI_API_KEY=

# Model used for the agent loop. See README for supported values.
GEOEXPLORER_MODEL=gpt-5.4-mini

# Seconds before an unused HERE response is re-fetched.
GEOEXPLORER_CACHE_TTL=900

# HERE Geocoding & Search API key — https://platform.here.com/
# Required. The app cannot resolve addresses without it.
HERE_API_KEY=your-here-api-key

# Model provider — set ANY ONE of these. Whichever is present is the one used; if you
# set several, GEOEXPLORER_MODEL below decides. Leave them all blank to be prompted in
# the sidebar instead, where the key's prefix identifies the provider automatically.
#
#   OpenAI     https://platform.openai.com/api-keys        sk-…
#   Anthropic  https://console.anthropic.com/settings/keys sk-ant-…
#   Google     https://aistudio.google.com/apikey          AIza…
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional. Pins the model, and picks the provider when several keys are set.
#   OpenAI     gpt-5.4-mini | gpt-5.4 | gpt-5.1 | gpt-4.1-mini
#   Anthropic  claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
#   Google     gemini-3.7-flash | gemini-3.6-flash | gemini-2.5-flash
GEOEXPLORER_MODEL=

# Seconds before an unused HERE response is re-fetched.
GEOEXPLORER_CACHE_TTL=900
